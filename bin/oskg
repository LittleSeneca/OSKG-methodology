#!/usr/bin/env python3
"""`oskg` launcher — runs from a checkout with no install step.

Puts the repository root on sys.path so the package resolves whether this file
was invoked directly or through a symlink in ~/.local/bin. Deliberately not a
console_script entry point: `oskg` must work on a machine with no venv, which is
the same reason the package has no dependencies.
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(_here))

from oskg.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
